{
  "name": "mvs-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop shell (Electron) for the MVS app",
  "license": "UNLICENSED",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/security.test.js test/commands.test.js test/sidecar.test.js test/deeplink.test.js test/config.test.js test/update.test.js test/logfile.test.js",
    "e2e": "node --test --test-concurrency=1 test/e2e.test.mjs test/deeplink.e2e.test.mjs",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis",
    "test:fuses": "node --test test/fuses.test.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "playwright-core": "1.56.1",
    "electron-builder": "26.17.0",
    "@electron/fuses": "2.1.3"
  },
  "productName": "MVS",
  "author": {
    "name": "MVS",
    "email": "spike@example.invalid"
  },
  "homepage": "https://github.com/moranmoa/MVP",
  "build": {
    "appId": "dev.mvs.app",
    "productName": "MVS",
    "executableName": "mvs",
    "publish": null,
    "asar": true,
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../ui/dist",
        "to": "ui"
      },
      {
        "from": "build/mvs-config.json",
        "to": "mvs-config.json"
      },
      {
        "from": "build/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "afterPack": "build/fuses.js",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "MVS <spike@example.invalid>",
      "extraResources": [
        {
          "from": ".core/mvs-core",
          "to": "mvs-core"
        }
      ],
      "executableArgs": [
        "--"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": ".core/mvs-core.exe",
          "to": "mvs-core.exe"
        }
      ],
      "extraFiles": [
        {
          "from": ".core/mvs-launcher.exe",
          "to": "mvs-launcher.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "unicode": true
    },
    "protocols": [
      {
        "name": "MVS invite",
        "schemes": [
          "mvs"
        ]
      }
    ]
  }
}
