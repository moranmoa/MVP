# Copy to .env and fill in. Never commit .env.

# Your domain, as configured in DNS (TURN realm, TCP/QUIC addresses).
DOMAIN=chat.example.com

# Subdomain Caddy serves wss:// on (profile "proxy"). Its DNS record must
# point at this PC; Caddy gets the TLS certificate for it automatically.
RELAY_DOMAIN=relay.example.org

# Addresses peers dial to reach the relay (comma-separated multiaddrs).
EXTERNAL_ADDRS=/dns4/chat.example.com/tcp/4001,/dns4/chat.example.com/udp/4001/quic-v1,/dns4/relay.example.org/tcp/443/wss

# Where the WebSocket port listens. Keep 127.0.0.1 when the reverse proxy runs on this PC.
WS_BIND=127.0.0.1

RUST_LOG=info
# How often the relay logs its "stats" line (counts only, no addresses).
STATS_INTERVAL_SECS=300
# Circuit limits. Unset = the raised values in docker-compose.yml; set to an
# empty value for libp2p's defaults (16 / 4 / 120 s / 128 KiB).
#MAX_CIRCUITS=256
#MAX_CIRCUITS_PER_PEER=8
#MAX_CIRCUIT_SECS=3600
#MAX_CIRCUIT_BYTES=33554432
# Address of the reverse-proxy hop as the relay sees it (e.g. the NPM or Caddy
# host), comma-separated. wss clients all arrive from it, so it skips the
# per-IP rate limits; the per-peer and global limits still apply.
PROXY_IPS=
# Parallel rustc jobs when building the relay image.
CARGO_BUILD_JOBS=4

# --- STUN for voice v1 (profile "stun") ---
# No settings here: STUN-only needs no secret or address. Forward 3478/udp on
# the router to this host. Clients get it from the repository variable
# MVS_STUN_URL = stun:<p2p-host>:3478 (the DNS-only hostname; never commit it).
# Its answers are only right once the host sees real source addresses (#220).

# --- Voice (phase 2, profile "voice") ---
# Public IP of your internet connection, needed by TURN.
PUBLIC_IP=203.0.113.10
# Long random string, e.g. from a password manager.
TURN_SECRET=change-me
