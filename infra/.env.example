# Copy to .env and fill in. Never commit .env.

# Your domain, as configured in DNS (TURN realm, TCP/QUIC addresses).
DOMAIN=chat.example.com

# Subdomain Caddy serves wss:// on (profile "proxy"). Its DNS record must
# point at this PC; Caddy gets the TLS certificate for it automatically.
RELAY_DOMAIN=relay.example.com

# Addresses peers dial to reach the relay (comma-separated multiaddrs).
EXTERNAL_ADDRS=/dns4/chat.example.com/tcp/4001,/dns4/chat.example.com/udp/4001/quic-v1,/dns4/relay.example.com/tcp/443/wss

# Where the WebSocket port listens. Keep 127.0.0.1 when the reverse proxy runs on this PC.
WS_BIND=127.0.0.1

RUST_LOG=info
# How often the relay logs its "stats" line (counts only, no addresses).
STATS_INTERVAL_SECS=300
# Parallel rustc jobs when building the relay image.
CARGO_BUILD_JOBS=4

# Relay circuit limits. Leave empty for libp2p's defaults (16 circuits, 4 per
# peer, 2 minutes and 128 KiB per circuit). Web clients that can only reach a
# peer through the relay need more; see spikes/web/RESULTS.md.
MAX_CIRCUITS=
MAX_CIRCUITS_PER_PEER=
MAX_CIRCUIT_SECS=
MAX_CIRCUIT_BYTES=

# --- Voice (phase 2, profile "voice") ---
# Public IP of your internet connection, needed by TURN.
PUBLIC_IP=203.0.113.10
# Long random string, e.g. from a password manager.
TURN_SECRET=change-me
