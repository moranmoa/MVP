# WebKitGTK 4.1 participant under Xvfb. Build context: spikes/voice
#   docker build -f bench/Dockerfile.webkit --build-arg BASE=debian:trixie .
ARG BASE=debian:trixie
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-gi gir1.2-gtk-3.0 gir1.2-webkit2-4.1 xvfb xauth iproute2 \
      gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-nice \
      gstreamer1.0-pulseaudio ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY web /voice/web
COPY bench/webkit-peer.py /voice/
CMD ["sh", "-c", "[ -n \"$NETEM\" ] && tc qdisc replace dev eth0 root netem $NETEM; exec xvfb-run -a python3 /voice/webkit-peer.py"]
